services:
  cadvisor:
    image: {{ cadvisor_image }}
    container_name: cadvisor
    restart: unless-stopped
    privileged: true

    ports:
      - "{{ cadvisor_port }}:8080"

    volumes:
    - /:/rootfs:ro
    - /var/run:/var/run:ro
    - /sys:/sys:ro
    - /sys/fs/cgroup:/sys/fs/cgroup:ro
    - /dev/disk:/dev/disk:ro
    
    command:
      - --docker_only=true