services:
  cadvisor:
    image: {{ cadvisor_image }}
    container_name: cadvisor
    restart: unless-stopped
    privileged: true
    cap_add:
      - SYS_ADMIN
      - SYS_RESOURCE

    ports:
      - "{{ cadvisor_port }}:8080"

    volumes:
      # Root filesystem
      - /:/rootfs:ro
      
      # Docker daemon socket (CRITICAL - was missing)
      - /var/run/docker.sock:/var/run/docker.sock:ro
      
      # Runtime
      - /var/run:/var/run:ro
      
      # Cgroups for LXC (correct path)
      - /sys/fs/cgroup:/sys/fs/cgroup:ro
      - /sys:/sys:ro
      
      # Device info
      - /dev/disk:/dev/disk:ro
      - /dev:/dev:ro
    
    command:
      - --docker_only=true
      - --housekeeping_interval=15s
      - --allow_dynamic_housekeeping=true
      - --containerd=/run/containerd/containerd.sock