# stacks/splunk/.env.j2
# OpenBao secret template for Splunk

# ============================================================
# Splunk-specific secrets
# Source: secret/splunk
# ============================================================

# Splunk admin password
SPLUNK_PASSWORD={{ app_secrets.SPLUNK_PASSWORD }}

# Splunk HEC token
SPLUNK_HEC_TOKEN={{ app_secrets.SPLUNK_HEC_TOKEN }}


# ============================================================
# Shared configuration
# Source: secret/shared
# ============================================================

# Splunk HEC URL
#http://192.168.1.102:8088
SPLUNK_HEC_URL={{ shared_secrets.SPLUNK_HEC_URL }}


# ============================================================
# Splunk configuration
# ============================================================

# Splunk admin username
SPLUNK_ADMIN_USER=admin

# License acceptance
SPLUNK_START_ARGS=--accept-license

# Container configuration
SPLUNK_DEPLOYMENT_SERVER=

# Timezone
TZ=Asia/Kolkata