# stacks/immich/.env.j2
# OpenBao-backed environment for Immich

# ============================================================
# Immich
# ============================================================

# Immich image version
# Pin this to a specific release for reproducible deployments.
IMMICH_VERSION=release

# ============================================================
# Database
# ============================================================

# Docker Compose service name
DB_HOSTNAME=database
DB_PORT=5432

DB_USERNAME={{ secrets.IMMICH_DB_USER | default('immich') }}
DB_PASSWORD={{ secrets.IMMICH_DB_PASSWORD | default('CHANGE_ME') }}
DB_DATABASE_NAME=immich

# PostgreSQL is intentionally stored on the LXC SSD.
DB_DATA_LOCATION=/opt/immich/postgres

# ============================================================
# Valkey / Redis
# ============================================================

REDIS_HOSTNAME=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ secrets.IMMICH_REDIS_PASSWORD | default('CHANGE_ME') }}

# ============================================================
# Immich Storage
# ============================================================

# External 1TB HDD mounted into the LXC at:
# /mnt/immich-data
#
# Immich media is stored here.
UPLOAD_LOCATION=/mnt/immich-data/library

# ML model cache
MODEL_CACHE_FOLDER=/mnt/immich-data/model-cache

# Import staging directory
IMMICH_IMPORT_PATH=/mnt/immich-data/import

# ============================================================
# General
# ============================================================

TZ=Asia/Kolkata

# ============================================================
# Logging
# ============================================================

IMMICH_LOG_LEVEL=log

# ============================================================
# Shared Splunk Configuration
# Source: OpenBao secret/shared
# ============================================================

SPLUNK_HEC_URL={{ shared_secrets.SPLUNK_HEC_URL | default('http://192.168.1.102:8088') }}

SPLUNK_HEC_TOKEN={{ shared_secrets.SPLUNK_HEC_TOKEN | default('CHANGE_ME') }}

SPLUNK_LOG_SOURCE=immich

# ============================================================
# Optional Immich URL
# ============================================================

# Set this only when you configure the reverse proxy.
# IMMICH_URL_EXTERNAL=https://photos.example.com

# ============================================================
# OpenBao
# ============================================================

# Immich-specific secrets are managed in:
# secret/immich
#
# Shared secrets are managed in:
# secret/shared
#
# Example:
#
# docker exec -it openbao bao kv patch secret/immich \
#   IMMICH_DB_USER="immich" \
#   IMMICH_DB_PASSWORD="<random_password>" \
#   IMMICH_REDIS_PASSWORD="<random_password>"
#
# docker exec -it openbao bao kv patch secret/shared \
#   SPLUNK_HEC_URL="http://192.168.1.102:8088" \
#   SPLUNK_HEC_TOKEN="<hec_token>"