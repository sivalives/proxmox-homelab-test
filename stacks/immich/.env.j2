# stacks/immich/.env.j2
# OpenBao secret template for Immich
# Variables are injected from OpenBao secrets

# ============================================================
# Immich Database Configuration
# Source: secret/immich
# ============================================================

# PostgreSQL credentials (from secret/immich)
DB_HOSTNAME=postgres
DB_PORT=5432
DB_USERNAME={{ secrets.IMMICH_DB_USER | default('immich') }}
DB_PASSWORD={{ secrets.IMMICH_DB_PASSWORD | default('CHANGE_ME') }}
DB_DATABASE_NAME=immich

# ============================================================
# Immich Redis Configuration
# Source: secret/immich
# ============================================================

REDIS_HOSTNAME=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ secrets.IMMICH_REDIS_PASSWORD | default('CHANGE_ME') }}

# ============================================================
# Immich Storage Paths
# All stored on external 1TB disk mounted at /mnt/immich-storage
# ============================================================

# Main photo library (organized by year/month)
UPLOAD_LOCATION=/mnt/immich-storage/library

# PostgreSQL data directory
DB_DATA_LOCATION=/mnt/immich-storage/postgres

# ML model cache
MODEL_CACHE_FOLDER=/mnt/immich-storage/model-cache

# Photo import staging directory (before organizing)
IMMICH_IMPORT_PATH=/mnt/immich-storage/import

# Photo archive organization format (year/month/day)
IMMICH_ARCHIVE_FORMAT={% raw %}{{YYYY}}/{{MM}}/{{dd}} - {{filename}}{% endraw %}

# ============================================================
# Immich Core Settings
# Source: secret/immich
# ============================================================

# Immich admin email and password (from secret/immich)
IMMICH_ADMIN_EMAIL={{ secrets.IMMICH_ADMIN_EMAIL | default('admin@immich.local') }}
IMMICH_ADMIN_PASSWORD={{ secrets.IMMICH_ADMIN_PASSWORD | default('CHANGE_ME') }}

# Immich version (use 'latest' or pin to specific version)
IMMICH_VERSION=latest

# Logging level (debug, info, warn, error)
IMMICH_LOG_LEVEL=info

# Disable ML features (face recognition, object detection) to save CPU
IMMICH_MACHINE_LEARNING_ENABLED=false

# ============================================================
# Immich Feature Flags
# ============================================================

# API rate limiting
IMMICH_API_TIERING_ENABLED=false

# OAuth/OIDC authentication
IMMICH_OAUTH_ENABLED=false

# Duplicate photo detection (CPU-intensive)
IMMICH_DUPLICATE_DETECTION_ENABLED=false

# ============================================================
# Immich Reverse Proxy & URL Configuration
# ============================================================

# External URL (used for sharing links, mobile app)
# Optional: set if using reverse proxy (Nginx, etc.)
# IMMICH_URL_EXTERNAL=https://photos.{{ domain_name }}

# Extract host from X-Forwarded-For headers (required for reverse proxy)
# IMMICH_SECURE_URL_FROM_LOG=true

# ============================================================
# Shared Configuration
# Source: secret/shared
# ============================================================

# Splunk HEC URL (HTTP Event Collector)
# http://192.168.1.102:8088
SPLUNK_HEC_URL={{ shared_secrets.SPLUNK_HEC_URL | default('http://192.168.1.102:8088') }}

# Splunk HEC authentication token (from secret/shared)
SPLUNK_HEC_TOKEN={{ shared_secrets.SPLUNK_HEC_TOKEN | default('CHANGE_ME') }}

# Splunk log source identifier
SPLUNK_LOG_SOURCE=immich

# ============================================================
# Timezone
# ============================================================

TZ=Asia/Kolkata

# ============================================================
# OpenBao Secret Management
# Run in LXC 102 (OpenBao server) - use 'patch' to avoid overwriting
# ============================================================

# Create/update Immich-specific secrets:
# docker exec -it openbao bao kv patch secret/immich \
#   IMMICH_DB_PASSWORD="<random_password>" \
#   IMMICH_REDIS_PASSWORD="<random_password>" \
#   IMMICH_ADMIN_PASSWORD="<admin_password>" \
#   IMMICH_ADMIN_EMAIL="admin@immich.local"

# Update shared Splunk credentials:
# docker exec -it openbao bao kv patch secret/shared \
#   SPLUNK_HEC_URL="http://192.168.1.102:8088" \
#   SPLUNK_HEC_TOKEN="<hec_token>"

# Verify secrets are set:
# docker exec -it openbao bao kv get secret/immich
# docker exec -it openbao bao kv get secret/shared