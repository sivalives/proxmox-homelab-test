# MinIO root username
MINIO_ROOT_USER={{ shared_secrets.MINIO_ROOT_USER | default('lakeadmin') }}

# MinIO root password
MINIO_ROOT_PASSWORD={{ shared_secrets.MINIO_ROOT_PASSWORD | default('CHANGE_ME') }}

# ============================================================
# Splunk HEC
# ============================================================

# Splunk HEC URL
SPLUNK_HEC_URL={{ shared_secrets.SPLUNK_HEC_URL | default('http://192.168.1.102:8088') }}

# Splunk HEC authentication token
SPLUNK_HEC_TOKEN={{ shared_secrets.SPLUNK_HEC_TOKEN | default('CHANGE_ME') }}