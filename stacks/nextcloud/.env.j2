# stacks/nextcloud/.env.j2

# ============================================================
# Shared Configuration
# Source: secret/shared
# ============================================================

# Splunk HEC URL

SPLUNK_HEC_URL={{ shared_secrets.SPLUNK_HEC_URL | default('http://192.168.1.102:8088') }}

# Splunk HEC authentication token

SPLUNK_HEC_TOKEN={{ shared_secrets.SPLUNK_HEC_TOKEN | default('CHANGE_ME') }}

# ============================================================
# Nextcloud Configuration
# Source: secret/nextcloud
# ============================================================

# PostgreSQL database password
POSTGRES_PASSWORD={{ app_secrets.POSTGRES_PASSWORD | default('CHANGE_ME') }}
# Redis authentication password
REDIS_PASSWORD={{ app_secrets.REDIS_PASSWORD | default('CHANGE_ME') }}
# Nextcloud administrator username
NEXTCLOUD_ADMIN_USER={{ app_secrets.NEXTCLOUD_ADMIN_USER | default('admin') }}
# Nextcloud administrator password
NEXTCLOUD_ADMIN_PASSWORD={{ app_secrets.NEXTCLOUD_ADMIN_PASSWORD | default('CHANGE_ME') }}
# Nextcloud trusted domain
NEXTCLOUD_TRUSTED_DOMAINS={{ app_secrets.NEXTCLOUD_TRUSTED_DOMAINS | default('nextcloud.lan') }}
