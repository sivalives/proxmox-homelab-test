# stacks/dockership/prometheus-pve-exporter/.env.j2

# ============================================================
# Netdata monitoring-specific secrets
# Source: secret/netdata
# ============================================================

# Proxmox API token for monitoring

PVE_USER=monitoring@pam
PVE_TOKEN_NAME=monitoring
PVE_TOKEN_VALUE={{ app_secrets.PVE_TOKEN_VALUE }}
# Optional: ntfy.sh configuration
NTFY_BASE_URL=http://192.168.1.108:8080
NTFY_TOKEN='{{ app_secrets.NTFY_TOKEN }}'
 
# Optional: Timezone
TZ=Asia/Kolkata

# Splunk HEC URL
SPLUNK_HEC_URL={{ shared_secrets.SPLUNK_HEC_URL | default('http://192.168.1.102:8088') }}

# Splunk HEC authentication token
SPLUNK_HEC_TOKEN={{ shared_secrets.SPLUNK_HEC_TOKEN | default('CHANGE_ME') }}

