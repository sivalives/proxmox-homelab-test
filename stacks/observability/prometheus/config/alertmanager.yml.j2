global:
  resolve_timeout: 5m
  http_config:
    follow_redirects: true
    enable_http2: true

templates: []

route:
  receiver: 'system-alerts'

  group_by:
    - alertname
    - service
    - severity

  group_wait: 10s
  group_interval: 10s
  repeat_interval: 6h

  routes:

    # ==========================================================
    # PROXMOX
    # ==========================================================
    - match:
        service: proxmox
      receiver: 'proxmox-alerts'
      repeat_interval: 4h
      continue: false

    # ==========================================================
    # DOCKER
    # ==========================================================
    - match:
        service: docker
      receiver: 'docker-alerts'
      repeat_interval: 2h
      continue: false

    # ==========================================================
    # PROMETHEUS / ALERTMANAGER
    # ==========================================================
    - match_re:
        service: 'prometheus|alertmanager'
      receiver: 'system-alerts'
      repeat_interval: 2h
      continue: false

      
receivers:

  # ============================================================
  # PROXMOX
  # ============================================================
  - name: 'proxmox-alerts'
    webhook_configs:

      # ntfy
      - url: 'http://ntfy:80/proxmox_alerts?template=homelab-notifications'
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: '{{ app_secrets.NTFY_TOKEN }}'

      # Splunk HEC
      - url: 'http://192.168.1.102:8088/services/collector/raw?channel=00872DC6-AC83-4EDE-8AFE-8413C3825C4C'
        send_resolved: true
        http_config:
          authorization:
            type: Splunk
            credentials: '{{ shared_secrets.SPLUNK_HEC_TOKEN }}'


  # ============================================================
  # DOCKER
  # ============================================================
  - name: 'docker-alerts'
    webhook_configs:

      # ntfy
      - url: 'http://ntfy:80/docker_alerts?template=homelab-notifications'
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: '{{ app_secrets.NTFY_TOKEN }}'

      # Splunk HEC
      - url: 'http://192.168.1.102:8088/services/collector/raw?channel=00872DC6-AC83-4EDE-8AFE-8413C3825C4C'
        send_resolved: true
        http_config:
          authorization:
            type: Splunk
            credentials: '{{ shared_secrets.SPLUNK_HEC_TOKEN }}'


  # ============================================================
  # SYSTEM
  # ============================================================
  - name: 'system-alerts'
    webhook_configs:

      # ntfy
      - url: 'http://ntfy:80/system_alerts?template=homelab-notifications'
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: '{{ app_secrets.NTFY_TOKEN }}'

      # Splunk HEC
      - url: 'http://192.168.1.102:8088/services/collector/raw?channel=00872DC6-AC83-4EDE-8AFE-8413C3825C4C'
        send_resolved: true
        http_config:
          authorization:
            type: Splunk
            credentials: '{{ shared_secrets.SPLUNK_HEC_TOKEN }}'

inhibit_rules:
  - source_match:
      severity: critical
      alertname: 'ProxmoxNodeDown'
    target_match_re:
      service: proxmox
    equal:
      - instance

  - source_match:
      severity: critical
      alertname: 'ProxmoxLXCDiskCritical'
    target_match:
      severity: warning
      alertname: 'ProxmoxLXCDiskHigh'
    equal:
      - id