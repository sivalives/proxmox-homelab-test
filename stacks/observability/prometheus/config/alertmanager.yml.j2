global:
  resolve_timeout: 5m
  http_config:
    follow_redirects: true
    enable_http2: true

templates: []

route:
  receiver: 'multi-channel'
  group_by:
    - alertname
    - service
    - severity
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 6h

  routes:
    - match:
        service: proxmox
        severity: critical
      receiver: 'proxmox-critical'
      group_wait: 5s
      repeat_interval: 1h
      continue: true

    - match:
        service: proxmox
        severity: warning
      receiver: 'proxmox-warning'
      repeat_interval: 4h
      continue: true

    - match_re:
        service: 'prometheus|alertmanager'
      receiver: 'system-alerts'
      repeat_interval: 2h
      continue: true

receivers:

  # Default: ntfy + Splunk
  - name: 'multi-channel'
    webhook_configs:
      # ntfy (if using Bearer token)
      - url: 'http://ntfy:80/homelab_alerts?template=alertmanager'
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: '{{ app_secrets.NTFY_TOKEN }}'

      # Splunk HEC (standard approach)
      - url: 'http://192.168.1.102:8088/services/collector'
        send_resolved: true
        http_config:
          authorization:
            type: Splunk
            credentials: '{{ shared_secrets.SPLUNK_HEC_TOKEN }}'

  # Proxmox critical
  - name: 'proxmox-critical'
    webhook_configs:
      - url: 'http://ntfy:80/proxmox_critical?template=alertmanager'
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: '{{ app_secrets.NTFY_TOKEN }}'

      - url: 'http://192.168.1.102:8088/services/collector'
        send_resolved: true
        http_config:
          authorization:
            type: Splunk
            credentials: '{{ shared_secrets.SPLUNK_HEC_TOKEN }}'

  # Proxmox warning
  - name: 'proxmox-warning'
    webhook_configs:
      - url: 'http://ntfy:80/proxmox_warning?template=alertmanager'
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: '{{ app_secrets.NTFY_TOKEN }}'

      - url: 'http://192.168.1.102:8088/services/collector'
        send_resolved: true
        http_config:
          authorization:
            type: Splunk
            credentials: '{{ shared_secrets.SPLUNK_HEC_TOKEN }}'

  # System alerts
  - name: 'system-alerts'
    webhook_configs:
      - url: 'http://ntfy:80/system_alerts?template=alertmanager'
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: '{{ app_secrets.NTFY_TOKEN }}'

      - url: 'http://192.168.1.102:8088/services/collector'
        send_resolved: true
        http_config:
          authorization:
            type: Splunk
            credentials: '{{ shared_secrets.SPLUNK_HEC_TOKEN }}'

inhibit_rules:
  - source_match:
      severity: critical
      alertname: 'ProxmoxNodeDown'
    target_match_re:
      service: proxmox
    equal:
      - instance

  - source_match:
      severity: critical
      alertname: 'ProxmoxLXCDiskCritical'
    target_match:
      severity: warning
      alertname: 'ProxmoxLXCDiskHigh'
    equal:
      - id