# stacks/pihole/.env.j2
# OpenBao secret template for Pi-hole
# Variables injected from OpenBao (secret/pihole and secret/shared)

# ============================================================
# Pi-hole Core Configuration
# Source: secret/pihole
# ============================================================

# Admin dashboard password (from OpenBao)
WEBPASSWORD={{ secrets.PIHOLE_PASSWORD | default('CHANGE_ME') }}

# Timezone
TZ=Asia/Kolkata

# Host IP (for DNS records)
HOST_IP=192.168.1.104

# DNS upstream servers (fallback)
PIHOLE_DNS=8.8.8.8;1.1.1.1

# IPv6 support
IPv6=True

# ============================================================
# Shared Configuration
# Source: secret/shared
# ============================================================

# Splunk HEC URL
SPLUNK_HEC_URL={{ shared_secrets.SPLUNK_HEC_URL | default('http://192.168.1.102:8088') }}

# Splunk HEC authentication token
SPLUNK_HEC_TOKEN={{ shared_secrets.SPLUNK_HEC_TOKEN | default('CHANGE_ME') }}

# ============================================================
# OpenBao Secret Management
# Run on LXC 102 (OpenBao server)
# ============================================================

# Create/update Pi-hole secrets:
# docker exec -it openbao bao kv patch secret/pihole \
#   PIHOLE_PASSWORD="<admin_password>"

# Update shared Splunk credentials:
# docker exec -it openbao bao kv patch secret/shared \
#   SPLUNK_HEC_URL="http://192.168.1.102:8088" \
#   SPLUNK_HEC_TOKEN="<hec_token>"

# Verify secrets:
# docker exec -it openbao bao kv get secret/pihole
# docker exec -it openbao bao kv get secret/shared