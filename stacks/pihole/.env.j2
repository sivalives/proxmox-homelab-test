# stacks/pihole/.env.j2
# OpenBao secret template for Pi-hole
# Variables are injected from OpenBao secrets

# Pi-hole admin password (from secret/pihole)
WEBPASSWORD={{ secrets.PIHOLE_PASSWORD | default('CHANGE_ME') }}

# Pi-hole timezone
TZ=Asia/Kolkata

# Optional: DNS settings
PIHOLE_DNS_=8.8.8.8;1.1.1.1

# Optional: Web interface port (if not default)
# WEBPORT=80

# Optional: IPv6 support
IPv6=True

HOST_IP=192.168.1.104

# ============================================================
# Shared configuration
# Source: secret/shared
# ============================================================

## Run in 101 bao server  -use patch instead of put to avoid overwriting existing secrets
##docker exec -it openbao bao kv patch secret/shared     SPLUNK_HEC_TOKEN="REPLACE"
#docker exec -it openbao bao kv patch secret/shared SPLUNK_HEC_TOKEN="REPLACE"

#Check secret 
#docker exec -it openbao bao kv get secret/shared




##

# Splunk HEC URL
#http://192.168.1.102:8088
SPLUNK_HEC_URL={{ shared_secrets.SPLUNK_HEC_URL }}
# Splunk HEC token
SPLUNK_HEC_TOKEN={{ shared_secrets.SPLUNK_HEC_TOKEN }}