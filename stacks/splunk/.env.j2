# stacks/splunk/.env.j2
# OpenBao secret template for Splunk
# Variables are injected from OpenBao secrets

# Splunk admin password (from secret/splunk)
SPLUNK_PASSWORD={{ secrets.SPLUNK_PASSWORD | default('CHANGE_ME') }}

# Splunk admin username
SPLUNK_ADMIN_USER=admin

# License acceptance
SPLUNK_START_ARGS=--accept-license

# Splunk HEC (HTTP Event Collector) token
SPLUNK_HEC_TOKEN={{ secrets.SPLUNK_HEC_TOKEN | default('CHANGE_ME') }}

# Optional: Shared secrets (from secret/shared)
{% if secrets.SPLUNK_HEC_URL is defined %}
SPLUNK_HEC_URL={{ secrets.SPLUNK_HEC_URL }}
{% else %}
SPLUNK_HEC_URL=http://localhost:8088/services/collector
{% endif %}

# Container configuration
SPLUNK_DEPLOYMENT_SERVER=

# Optional: Additional environment variables
TZ=Asia/Kolkata